# Copia este archivo a .env y completa tu clave
# Obtén tu clave en https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Marco de segundos de espera (backoff) para un modelo que falla con 429
BACKOFF_SECONDS=300

# Re-fetch del listado de modelos cada X segundos (default 6 horas)
POOL_REFRESH_SECONDS=21600

# Mostrar informacion de debug en consola
DEBUG=true
